#!/usr/bin/env bash
set -euo pipefail

if ! curl -sf -o /dev/null --connect-timeout 2 http://localhost:3000; then
  echo "Local HTTP server serving the test is down. Ask the user to start the server before trying to run this test."
  exit 1
fi

CHROME_DEVTOOLS_STATUS=$(chrome-devtools status)
if [[ "${CHROME_DEVTOOLS_STATUS}" == *"not running"* ]]; then
    echo "chrome-devtools daemon is not running. Ask the user to start the chrome-devtools daemon before trying to run this test."
    exit 1
fi

echo "Starting test-cv-template-matching..."
chrome-devtools new_page "http://localhost:3000/optimizer?test=1&debug=1" &>/dev/null
# Reload to ignore the cache
chrome-devtools navigate_page --type "reload" --ignoreCache true &>/dev/null

# Close old pages opened by previous test runs in the live test browser
readarray -t page_ids < <(chrome-devtools list_pages --output-format=json | jq -r '.pages[] | select(.selected != true) | .id')
# Iterate over the unselected IDs
for id in "${page_ids[@]}"; do
  setsid --fork -- chrome-devtools close_page "${id}" </dev/null >/dev/null 2>&1
done

CV_TEMPLATE_MATCHING_TEST_OUTPUT=$(chrome-devtools evaluate_script "async () => await OCRTest.runImageOpenCvTemplateMatchingTests()")

echo "${CV_TEMPLATE_MATCHING_TEST_OUTPUT}"
if [[ "${CV_TEMPLATE_MATCHING_TEST_OUTPUT}" != *"CV_TEMPLATE_MATCHING_TEST_PASS"* ]]; then
  echo "OpenCV template matching test failed."
  exit 1
fi
